<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="12dp">

    <!-- Top Section (Handle Bar + Playlist Header + Divider) -->
    <LinearLayout
        android:id="@+id/detailHeaderSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#33FFFFFF" />

        <!-- Playlist Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/detailPlaylistIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="#2A2A2A"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/baseline_music_note_24"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detailPlaylistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Favorites" />

                <TextView
                    android:id="@+id/detailPlaylistCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/light_gray"
                    android:textSize="13sp"
                    tools:text="12 Songs" />

            </LinearLayout>

            <ImageView
                android:id="@+id/detailBtnPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_white_bg"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/baseline_play_arrow_24" />

            <ImageView
                android:id="@+id/detailBtnShuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/baseline_shuffle_24"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/detailBtnSort"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/baseline_sort_24"
                app:tint="@color/white" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="#22FFFFFF" />

    </LinearLayout>

    <!-- Mini-Player Bar Anchored at Bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detailMiniPlayerLayout"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="#121212"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/detailMiniAlbumArt"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/baseline_music_note_24" />

        <LinearLayout
            android:id="@+id/detailMiniTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/detailMiniBtnPrev"
            app:layout_constraintStart_toEndOf="@+id/detailMiniAlbumArt"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/detailMiniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Song Title" />

            <TextView
                android:id="@+id/detailMiniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/light_gray"
                android:textSize="11sp"
                tools:text="Artist Name" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detailMiniTextElapsed"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/light_gray"
                    android:textSize="10sp"
                    tools:text="0:00" />

                <SeekBar
                    android:id="@+id/detailMiniSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:minHeight="1.5dp"
                    android:maxHeight="1.5dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:progressDrawable="@drawable/bg_mini_seekbar_track"
                    android:thumb="@drawable/bg_mini_seekbar_thumb"
                    android:thumbOffset="0dp" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/detailMiniBtnPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/baseline_skip_previous_24"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/detailMiniBtnPlay"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/detailMiniBtnPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/baseline_play_arrow_24"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/detailMiniBtnNext"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/detailMiniBtnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/baseline_skip_next_24"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/detailEmptyText"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_below="@id/detailHeaderSection"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="No songs in playlist yet"
        android:textColor="@color/light_gray"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Playlist Songs RecyclerView filling space between Header and Mini-Player -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPlaylistSongs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/detailMiniPlayerLayout"
        android:layout_below="@id/detailHeaderSection"
        android:layout_alignWithParentIfMissing="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

</RelativeLayout>
