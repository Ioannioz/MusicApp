<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTheme"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#121212"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutThemeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/layoutThemeBadges"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textThemeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Black &amp; White" />

            <TextView
                android:id="@+id/textThemeDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/light_gray"
                android:textSize="12sp"
                tools:text="Sleek dark background with high-contrast white text" />

            <!-- Palette Color Dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotBg"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/circle_white_bg" />

                <View
                    android:id="@+id/dotCard"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/circle_white_bg" />

                <View
                    android:id="@+id/dotAccent"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/circle_white_bg" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutThemeBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/badgeActiveTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="ACTIVE"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="#1DB954" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
