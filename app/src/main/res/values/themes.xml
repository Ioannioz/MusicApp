<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorSecondary">#AAAAAA</item>
        <item name="colorAccent">#3D3D3D</item>
        <item name="colorControlActivated">#AAAAAA</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>

        <!-- Default Button Style for all buttons in the app -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <!-- Custom Button Style matching bg_button_secondary -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#444444</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">#555555</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
</resources>
